{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DNUMERIC_BACKEND=IQMATH",
                "-GNinja",
                "-Bbuild-iqmath-softfp"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Tools/BuildSequential.ps1",
                "-Backend",
                "IQMATH",
                "-BuildDirectory",
                "build-iqmath-softfp"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Generate A2L",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Tools/GenerateA2L.ps1",
                "-BuildDirectory",
                "build-iqmath-softfp"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "Clean ELF",
            "type": "shell",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/c"
                    ]
                }
            },
            "command": "cmd",
            "args": [
                "/c",
                "if",
                "exist",
                "build-iqmath-softfp/${workspaceFolderBasename}.elf",
                "del",
                "/f",
                "build-iqmath-softfp/${workspaceFolderBasename}.elf"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build",
            "dependsOn": [
                "CMake Configure",
                "CMake Build",
                "Generate A2L"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Flash",
            "type": "shell",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/c"
                    ]
                },
                "cwd": "${workspaceFolder}"
            },
            "command": "JLink.exe -CommanderScript Tools/flash_iqmath.jlink",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build FLOAT_REF",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Tools/BuildSequential.ps1",
                "-Backend",
                "FLOAT_REF",
                "-BuildDirectory",
                "build-float-ref"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}
